# Copy this file to .env and fill in real values. Never commit .env.

# SQLite connection string used by Prisma. For local dev, a relative file is
# fine; in Docker this is overridden to a mounted volume path (see Dockerfile).
DATABASE_URL="file:./dev.db"

# Comma-separated list of origins allowed to call this API (CORS). The
# Capacitor mobile app calls the API from "https://localhost" (Android's
# default webview origin), and the marketing/auth site (gymstrack.app) calls
# it directly too (register/login/Stripe checkout) — add them once deployed:
# CORS_ORIGIN="https://gymstrack.com,https://gymstrack.app,https://localhost"
CORS_ORIGIN="http://localhost:5173"

# Public URL of the frontend — used to build links in transactional emails
# (password reset) and Stripe Checkout/Portal redirect URLs.
FRONTEND_URL="http://localhost:5173"

# Public URL of the marketing/auth site (gymstrack.app) — the other allowed
# Stripe Checkout return origin. Visitors there register/log in and buy Pro
# without ever being sent to the web app itself; createCheckoutSession only
# honors a successUrl/cancelUrl whose origin matches this or FRONTEND_URL,
# so this must be set for the marketing site's checkout links to actually
# return there instead of silently falling back to FRONTEND_URL.
MARKETING_SITE_URL="http://localhost:3002"

# Public URL of this backend itself — used to build absolute URLs to static
# assets it serves (e.g. exercise demonstration GIFs), since the frontend
# is on a different origin and can't resolve a relative path.
BACKEND_URL="http://localhost:3000"

# WorkoutX API key (https://workoutxapp.com) — required at runtime: the
# server calls the live API the first time a given exercise's GIF is viewed,
# then caches it on disk and never calls the API again for that exercise
# (see services/workoutXGifService.ts). Without this set, the GIF endpoint
# just 404s and the frontend falls back to the static exercise image.
WORKOUTX_API_KEY=""

# Secret used to sign/verify JWT auth tokens. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth (Sign in with Google). Client ID must match the one hardcoded
# in frontend/src/components/GoogleLoginButton.tsx (client IDs are public).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email) API key, used to send password-reset emails.
RESEND_API_KEY=""

# Stripe (Pro subscriptions on web/iOS). Price IDs come from the Stripe Dashboard.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# RevenueCat (Pro subscriptions on Android, via Google Play Billing — required
# by Play Store policy). Set this to the same value entered as the
# "Authorization header value" when creating the webhook in the RevenueCat
# dashboard (Project settings → Integrations → Webhooks).
REVENUECAT_WEBHOOK_SECRET=""
