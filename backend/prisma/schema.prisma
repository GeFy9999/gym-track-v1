// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

 model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   
  createdAt DateTime @default(now())
  schedule  Schedule? 
  sessions Session[]
  bodyWeights BodyWeight[]
  trackedExercises TrackedExercise[]
  progressPhotos   ProgressPhoto[]
  exerciseNotes    ExerciseNote[]
  recoveryEmail String?
  weightUnit    String   @default("lb")
  restTimerSeconds Int   @default(120)
  restTimerEnabled Boolean @default(false)
  barbellModeEnabled Boolean @default(false)
  language      String   @default("fr")
  authProvider  String   @default("email")
  resetToken    String?
  resetTokenExpiry DateTime?  
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String   @unique
  frequency Int
  days      String

  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  muscleGroup   String
  completed     Boolean  @default(false)
  date          DateTime @default(now())
  importBatchId String?
  sessionExercises SessionExercise[]
  user        User      @relation(fields: [userId], references: [id])
}

model Exercise {
  id            String  @id @default(uuid())
  
  muscleGroupId String
  name          String
  image         String?
  isCustom      Boolean @default(false)  
  muscleGroup   MuscleGroup  @relation(fields: [muscleGroupId], references: [id])  
  sessionExercises SessionExercise[]
  trackedBy TrackedExercise[]
  notes     ExerciseNote[]
}

model SessionExercise {
  id            String  @id @default(uuid())
  sessionId     String
  exerciseId    String
  order         Int     @default(0)
  supersetId    String?
  sets          Set[]
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  session       Session  @relation(fields: [sessionId], references: [id])
}

model Set {
  id         String  @id @default(uuid())
  sessionExerciseId String
  weight     Float
  reps       Int
  unit       String  @default("lb")
  completed  Boolean @default(false)
  type       String  @default("normal")

  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id])
}

model MuscleGroup {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  image       String?

  exercises   Exercise[]
}

model BodyWeight {
  id        String   @id @default(uuid())
  userId    String
  value     Float
  date      DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

model TrackedExercise {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([userId, exerciseId])
}

model ExerciseNote {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  note       String
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([userId, exerciseId])
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  data      String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}