# Copy this file to .env (local dev) or .env.production and fill in real values.

# Base URL of the backend API.
VITE_API_URL="http://localhost:3000/api"

# RevenueCat public API key for Android (Google Play Billing) — from the
# RevenueCat dashboard, Project settings → API keys → Google Play Store app.
# Only used on native Android builds; safe to be public like a Stripe
# publishable key. Leave empty until the RevenueCat project is set up.
VITE_REVENUECAT_ANDROID_API_KEY=""
